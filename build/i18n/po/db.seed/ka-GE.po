msgstr "საჯარო კატალოგში ბორდიურზე დანიშვნების მკითხველის მოდიფიკაციის გამორთვა"

# id::coust.description__circ.curbside.disable_patron_input
#: 950.data.seed-values.sql:22204
msgid ""
"When set to TRUE, patrons cannot use the My Account interface to select "
"curbside pickup times"
msgstr "როდესაც დაყენებულია TRUE-ზე, პატრონებს არ შეუძლიათ გამოიყენონ ჩემი ანგარიშის ინტერფეისი ბორდიურზე აყვანის დროის ასარჩევად"

# id::ath.description__hold.offer_curbside
#: 950.data.seed-values.sql:22222
msgid "Hook used to trigger the notification of an offer of curbside pickup"
msgstr "ჰუკი გამოიყენებოდა ბორდიურზე პიკაპის შეთავაზების შესახებ შეტყობინების გასააქტიურებლად"

# id::ath.description__hold.confirm_curbside
#: 950.data.seed-values.sql:22235
msgid ""
"Hook used to trigger the notification of the creation or update of a "
"curbside pickup appointment with an arrival URL"
msgstr "Hook გამოიყენება ბორდიურზე პიკაპის შეხვედრის შექმნის ან განახლების შესახებ შეტყობინების გასააქტიურებლად URL ჩასვლით"

# id::cgf.label__opac.use_geolocation
#: 950.data.seed-values.sql:22259
