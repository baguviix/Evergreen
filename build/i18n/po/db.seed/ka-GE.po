msgstr "მომხმარებლის სახელის ფორმატი"

# id::coust.description__opac.username_regex
#: 950.data.seed-values.sql:4992
msgid ""
"Regular expression defining the patron username format, used for patron "
"registration and self-service username changing only"
msgstr "რეგულარული გამოხატულება, რომელიც განსაზღვრავს პატრონის მომხმარებლის სახელის ფორმატს, გამოიყენება მხოლოდ პატრონის რეგისტრაციისა და თვითმომსახურების მომხმარებლის სახელის შესაცვლელად"

# id::coust.label__org.bounced_emails
