# id::coust.label__vendor.quipu.erenew.num_addresses_required
#: 950.data.seed-values.sql:4868
msgid ""
"Number of valid addresses needed to offer patron account e-renewal via Quipu"
msgstr "მოქმედი მისამართების რაოდენობა საჭიროა პატრონის ანგარიშის ელექტრონული განახლების შეთავაზებისთვის Quipu-ს მეშვეობით"

# id::coust.description__vendor.quipu.erenew.num_addresses_required
#: 950.data.seed-values.sql:4871
msgid ""
"Number of valid addresses that a patron record must have in order to offer "
"e-renewal via Quipu. Zero means that the patron record address are not "
"considered; one means that either the mailing or billing/physical address "
"must be set and marked as valid; two means that both the mailing and "
"billing/physical address must be set and marked as valid. Default value is "
"two (2)."
msgstr "მოქმედი მისამართების რაოდენობა, რომელიც უნდა ჰქონდეს პატრონის ჩანაწერს, რათა შესთავაზოს ელექტრონული განახლება Quipu-ს მეშვეობით. ნულოვანი ნიშნავს, რომ პატრონის ჩანაწერის მისამართი არ განიხილება; ერთი ნიშნავს, რომ ან საფოსტო ან ბილინგის/ფიზიკური მისამართი უნდა იყოს მითითებული და მონიშნული, როგორც მოქმედი; ორი ნიშნავს, რომ როგორც საფოსტო, ასევე ბილინგის/ფიზიკური მისამართი უნდა იყოს მითითებული და მონიშნული, როგორც მოქმედი. ნაგულისხმევი მნიშვნელობა არის ორი (2)."

# id::coust.label__lib.info_url
#: 950.data.seed-values.sql:4877
