msgstr "სამიზნე ასლები დაჯავშნისთვის მაშინაც კი, თუ ასლის ცირკულაციის lib დახურულია"

# id::coust.description__circ.holds.target_when_closed
#: 950.data.seed-values.sql:5810
msgid ""
"If this setting is true at a given org unit or one of its ancestors, the "
"hold targeter will target copies from this org unit even if the org unit is "
"closed (according to the actor.org_unit.closed_date table)."
msgstr "თუ ეს პარამეტრი მართალია მოცემულ ორგანულ ერთეულზე ან მის ერთ-ერთ წინაპარზე, დაკავების სამიზნე მიზნად ისახავს ამ ორგანული ერთეულის ასლებს, მაშინაც კი, თუ ორგანული ერთეული დახურულია (actor.org_unit.closed_date ცხრილის მიხედვით)."

# id::coust.label__circ.holds.target_when_closed_if_at_pickup_lib
#: 950.data.seed-values.sql:5815
msgid ""
"Target copies for a hold even if copy's circ lib is closed IF the circ lib "
"is the hold's pickup lib"
msgstr "სამიზნე ასლები დაჯავშნისთვის მაშინაც კი, თუ ასლის ტირაჟის lib დახურულია IF ცირკულაციის lib არის ჯავშნის ამოღება"

# id::coust.description__circ.holds.target_when_closed_if_at_pickup_lib
#: 950.data.seed-values.sql:5818
msgid ""
"If this setting is true at a given org unit or one of its ancestors, the "
"hold targeter will target copies from this org unit even if the org unit is "
"closed (according to the actor.org_unit.closed_date table) IF AND ONLY IF "
"the copy's circ lib is the same as the hold's pickup lib."
msgstr "თუ ეს პარამეტრი ჭეშმარიტია მოცემულ ორგანულ ერთეულზე ან მის ერთ-ერთ წინაპარზე, შეკავების სამიზნე მიზნად ისახავს ასლებს ამ ორგანული ერთეულიდან მაშინაც კი, თუ ორგანული ერთეული დახურულია (actor.org_unit.closed_date ცხრილის მიხედვით) იგივეა რაც სამაგრის პიკაპის lib."

# id::coust.label__opac.staff.jump_to_details_on_single_hit
#: 950.data.seed-values.sql:5825
msgid "Jump to details on 1 hit (staff client)"
msgstr "გადადით დეტალებზე 1 დარტყმაზე (პერსონალის კლიენტი)"

# id::coust.description__opac.staff.jump_to_details_on_single_hit
#: 950.data.seed-values.sql:5828
msgid ""
"When a search yields only 1 result, jump directly to the record details "
"page.  This setting only affects the OPAC within the staff client"
msgstr "როდესაც ძიება იძლევა მხოლოდ 1 შედეგს, გადადით პირდაპირ ჩანაწერის დეტალების გვერდზე.  ეს პარამეტრი გავლენას ახდენს მხოლოდ OPAC პერსონალის კლიენტში"

# id::coust.label__opac.patron.jump_to_details_on_single_hit
#: 950.data.seed-values.sql:5833
msgid "Jump to details on 1 hit (public)"
msgstr "1 დარტყმის დეტალებზე გადასვლა (საჯარო)"

# id::coust.description__opac.patron.jump_to_details_on_single_hit
#: 950.data.seed-values.sql:5836
msgid ""
"When a search yields only 1 result, jump directly to the record details "
"page.  This setting only affects the public OPAC"
msgstr "როდესაც ძიება იძლევა მხოლოდ 1 შედეგს, გადადით პირდაპირ ჩანაწერის დეტალების გვერდზე.  ეს პარამეტრი ეხება მხოლოდ საჯარო OPAC"

# id::coust.label__opac.search.tag_circulated_items
#: 950.data.seed-values.sql:5842
msgid "Tag Circulated Items in Results"
msgstr "მონიშნეთ გავრცელებული ნივთები შედეგებში"

# id::coust.description__opac.search.tag_circulated_items
#: 950.data.seed-values.sql:5847
msgid ""
"When a user is both logged in and has opted in to circulation history "
"tracking, turning on this setting will cause previous (or currently) "
"circulated items to be highlighted in search results"
msgstr "როდესაც მომხმარებელი შესულია სისტემაში და მონაწილეობს ტირაჟის ისტორიის თვალყურის დევნებაზე, ამ პარამეტრის ჩართვა გამოიწვევს წინა (ან ამჟამად) გავრცელებული ერთეულების ხაზგასმას ძიების შედეგებში"

# id::coust.label__sms.enable
#: 950.data.seed-values.sql:5855
msgid "Enable features that send SMS text messages."
msgstr "ჩართეთ ფუნქციები, რომლებიც აგზავნიან SMS ტექსტურ შეტყობინებებს."

# id::coust.description__sms.enable
#: 950.data.seed-values.sql:5861
msgid ""
"Current features that use SMS include hold-ready-for-pickup notifications "
"and a \"Send Text\" action for call numbers in the OPAC. If this setting is "
"not enabled, the SMS options will not be offered to the user.  Unless you "
"are carefully silo-ing patrons and their use of the OPAC, the context org "
"for this setting should be the top org in the org hierarchy, otherwise "
"patrons can trample their user settings when jumping between orgs."
msgstr "ამჟამინდელი ფუნქციები, რომლებიც იყენებენ SMS-ს, მოიცავს შეტყობინებებს, რომლებიც მზად არიან აიღოთ და \"ტექსტის გაგზავნა\" მოქმედებას ზარის ნომრებისთვის OPAC-ში. თუ ეს პარამეტრი არ არის ჩართული, SMS ვარიანტები არ იქნება შეთავაზებული მომხმარებლისთვის.  თუ თქვენ არ ხართ გულდასმით მფარველები და არ იყენებთ OPAC-ს, ამ პარამეტრის კონტექსტური ორგანიზაცია უნდა იყოს ორგანიზაციის იერარქიის ზედა ორგანო, წინააღმდეგ შემთხვევაში პატრონებს შეუძლიათ დაარღვიონ თავიანთი მომხმარებლის პარამეტრები ორგებს შორის გადახტომისას."

# id::coust.label__sms.disable_authentication_requirement.callnumbers
#: 950.data.seed-values.sql:5869
msgid "Disable auth requirement for texting call numbers."
msgstr "გამორთეთ ავტორიზაციის მოთხოვნა ზარის ნომრების გაგზავნისთვის."

# id::coust.description__sms.disable_authentication_requirement.callnumbers
#: 950.data.seed-values.sql:5875
msgid ""
"Disable authentication requirement for sending call number information via "
"SMS from the OPAC."
msgstr "გამორთეთ ავტორიზაციის მოთხოვნა ზარის ნომრის ინფორმაციის გაგზავნისთვის SMS-ით OPAC-დან."

# id::coust.label__serial.default_display_grouping
#: 950.data.seed-values.sql:5883
msgid ""
"Default display grouping for serials distributions presented in the OPAC."
msgstr "ნაგულისხმევი ჩვენების დაჯგუფება სერიული დისტრიბუციებისთვის წარმოდგენილი OPAC-ში."

# id::coust.description__serial.default_display_grouping
#: 950.data.seed-values.sql:5889
msgid ""
"Default display grouping for serials distributions presented in the OPAC. "
"This can be \"enum\" or \"chron\"."
msgstr "ნაგულისხმევი ჩვენების დაჯგუფება სერიული დისტრიბუციებისთვის, რომლებიც წარმოდგენილია OPAC-ში. ეს შეიძლება იყოს \"enum\" ან \"chron\"."

# id::coust.label__vandelay.default_match_set
# id::coust.description__vandelay.default_match_set
#: 950.data.seed-values.sql:5897 950.data.seed-values.sql:5903
msgid "Default Record Match Set"
msgstr "ნაგულისხმევი ჩანაწერების მატჩის ნაკრები"

# id::coust.label__cat.default_merge_profile
#: 950.data.seed-values.sql:5912
msgid "Default Merge Profile (Z39.50 and Record Buckets)"
msgstr "ნაგულისხმევი შერწყმის პროფილი (Z39.50 და ჩანაწერის კალათები)"

# id::coust.description__cat.default_merge_profile
#: 950.data.seed-values.sql:5918
msgid ""
"Default merge profile to use during Z39.50 imports and record bucket merges"
msgstr "ნაგულისხმევი შერწყმის პროფილი გამოსაყენებლად Z39.50 იმპორტისა და ჩანაწერის თაიგულების შერწყმის დროს"

# id::coust.label__opac.browse.pager_shortcuts
#: 950.data.seed-values.sql:5928
msgid "Paging shortcut links for OPAC Browse"
msgstr "პეიჯინგის მალსახმობების ბმულები OPAC დათვალიერებისთვის"

# id::coust.description__
#: 950.data.seed-values.sql:5934
msgid ""
"The characters in this string, in order, will be used as shortcut links for "
"quick paging in the OPAC browse interface. Any sequence surrounded by "
"asterisks will be taken as a whole label, not split into individual labels "
"at the character level, but only the first character will serve as the basis"
" of the search."
msgstr "ამ სტრიქონის სიმბოლოები, თანმიმდევრობით, გამოყენებული იქნება როგორც მალსახმობების ბმულები სწრაფი პეიჯინგისთვის OPAC ბრაუზერის ინტერფეისში. ვარსკვლავით გარშემორტყმული ნებისმიერი თანმიმდევრობა მიიღება როგორც მთლიანი ლეიბლი, არ იყოფა ცალკეულ ლეიბლებად სიმბოლოების დონეზე, მაგრამ მხოლოდ პირველი სიმბოლო იქნება ძიების საფუძველი."

# id::coust.label__circ.patron_edit.duplicate_patron_check_depth
#: 950.data.seed-values.sql:5943
msgid ""
"Specify search depth for the duplicate patron check in the patron editor"
msgstr "მიუთითეთ ძებნის სიღრმე დუბლიკატი პატრონის შემოწმებისთვის მფარველ რედაქტორში"

# id::coust.description__circ.patron_edit.duplicate_patron_check_depth
#: 950.data.seed-values.sql:5948
msgid ""
"When using the patron registration page, the duplicate patron check will use"
" the configured depth to scope the search for duplicate patrons."
msgstr "პატრონის სარეგისტრაციო გვერდის გამოყენებისას, დუბლიკატი პატრონის შემოწმება გამოიყენებს კონფიგურირებულ სიღრმეს დუბლიკატი პატრონების ძიებისთვის."

# id::coust.label__circ.use_lost_paid_copy_status
#: 950.data.seed-values.sql:5956
msgid "Use Lost and Paid copy status"
msgstr "გამოიყენეთ დაკარგული და ფასიანი ასლის სტატუსი"

# id::coust.description__circ.use_lost_paid_copy_status
#: 950.data.seed-values.sql:5959
msgid ""
"Use Lost and Paid copy status when lost or long overdue billing is paid"
msgstr "გამოიყენეთ დაკარგული და ფასიანი ასლის სტატუსი, როდესაც დაკარგული ან დიდი ხნის ვადაგადაცილებული ბილინგი გადახდილია"

# id::coust.label__circ.checkin.lost_zero_balance.do_not_change
#: 950.data.seed-values.sql:5965
msgid "Do not change fines/fees on zero-balance LOST transaction"
msgstr "ნუ შეცვლით ჯარიმებს/საკომისიოებს ნულოვანი ბალანსის LOST ტრანზაქციაზე"

# id::coust.description__circ.checkin.lost_zero_balance.do_not_change
#: 950.data.seed-values.sql:5968
msgid ""
"When an item has been marked lost and all fines/fees have been completely "
"paid on the transaction, do not void or reinstate any fines/fees EVEN IF "
"circ.void_lost_on_checkin and/or circ.void_lost_proc_fee_on_checkin are "
"enabled"
msgstr "როდესაც ნივთი მოინიშნა დაკარგულად და ყველა ჯარიმა/საკომისიო სრულად არის გადახდილი ტრანზაქციაზე, არ გააუქმოთ ან აღადგინოთ ჯარიმები/საკომისიოები EVEN IF circ.void_lost_on_checkin და/ან circ.void_lost_proc_fee_on_checkin ჩართულია"

# id::coust.label__bill.prohibit_negative_balance_default
#: 950.data.seed-values.sql:5974
msgid "Prohibit negative balance on bills (DEFAULT)"
msgstr "უარყოფითი ბალანსის აკრძალვა გადასახადებზე (DEFAULT)"

# id::coust.description__bill.prohibit_negative_balance_default
#: 950.data.seed-values.sql:5978
msgid ""
"Default setting to prevent negative balances (refunds) on circulation "
"related bills. Set to \"true\" to prohibit negative balances at all times "
"or, when used in conjunction with an interval setting, to prohibit negative "
"balances after a set period of time. "
msgstr "ნაგულისხმევი პარამეტრი მიმოქცევასთან დაკავშირებულ გადასახადებზე უარყოფითი ნაშთების (ანაზღაურების) თავიდან ასაცილებლად. დააყენეთ „true“-ზე, რათა აიკრძალოს უარყოფითი ნაშთები ნებისმიერ დროს, ან, როდესაც გამოიყენება ინტერვალის პარამეტრებთან ერთად, აკრძალოს უარყოფითი ნაშთები გარკვეული პერიოდის შემდეგ."

# id::coust.label__bill.prohibit_negative_balance_on_overdues
#: 950.data.seed-values.sql:5984
msgid "Prohibit negative balance on bills for overdue materials"
msgstr "აკრძალეთ უარყოფითი ბალანსი ვადაგადაცილებული მასალების გადასახადებზე"

# id::coust.description__bill.prohibit_negative_balance_on_overdues
#: 950.data.seed-values.sql:5988
msgid ""
"Prevent negative balances (refunds) on bills for overdue materials. Set to "
"\"true\" to prohibit negative balances at all times or, when used in "
"conjunction with an interval setting, to prohibit negative balances after a "
"set period of time."
msgstr "თავიდან აიცილეთ უარყოფითი ნაშთები (ანაზღაურება) ვადაგადაცილებული მასალების გადასახადებზე. დააყენეთ „true“-ზე, რათა აიკრძალოს უარყოფითი ნაშთები ნებისმიერ დროს, ან, როდესაც გამოიყენება ინტერვალის პარამეტრებთან ერთად, აკრძალოს უარყოფითი ნაშთები გარკვეული პერიოდის შემდეგ."

# id::coust.label__bill.prohibit_negative_balance_on_lost
#: 950.data.seed-values.sql:5994
msgid "Prohibit negative balance on bills for lost materials"
msgstr "აკრძალეთ დაკარგული მასალების გადასახადებზე უარყოფითი ბალანსი"

# id::coust.description__bill.prohibit_negative_balance_on_lost
#: 950.data.seed-values.sql:5998
msgid ""
"Prevent negative balances (refunds) on bills for lost/long overdue "
"materials. Set to \"true\" to prohibit negative balances at all times or, "
"when used in conjunction with an interval setting, to prohibit negative "
"balances after an interval of time."
msgstr "თავიდან აიცილეთ უარყოფითი ნაშთები (ანაზღაურება) დაკარგული/ვადაგადაცილებული მასალების გადასახადებზე. დააყენეთ \"true\", რათა აიკრძალოს უარყოფითი ნაშთები ნებისმიერ დროს, ან, როდესაც გამოიყენება ინტერვალის პარამეტრებთან ერთად, აკრძალოს უარყოფითი ნაშთები დროის ინტერვალის შემდეგ."

# id::coust.label__bill.negative_balance_interval_default
#: 950.data.seed-values.sql:6004
msgid "Negative Balance Interval (DEFAULT)"
msgstr "უარყოფითი ბალანსის ინტერვალი (DEFAULT)"

# id::coust.description__bill.negative_balance_interval_default
#: 950.data.seed-values.sql:6008
msgid ""
"Amount of time after which no negative balances (refunds) are allowed on "
"circulation bills. The \"Prohibit negative balance on bills\" setting must "
"also be set to \"true\"."
msgstr "დროის ოდენობა, რომლის შემდეგაც არ დაიშვება უარყოფითი ნაშთები (ანაზღაურება) მიმოქცევაში. პარამეტრი \"აკრძალოს უარყოფითი ბალანსი გადასახადებზე\" ასევე უნდა იყოს მითითებული \"true\"."

# id::coust.label__bill.negative_balance_interval_on_overdues
#: 950.data.seed-values.sql:6014
msgid "Negative Balance Interval for Overdues"
msgstr "უარყოფითი ბალანსის ინტერვალი ვადაგადაცილებისთვის"

# id::coust.description__bill.negative_balance_interval_on_overdues
#: 950.data.seed-values.sql:6018
msgid ""
"Amount of time after which no negative balances (refunds) are allowed on "
"bills for overdue materials. The \"Prohibit negative balance on bills for "
"overdue materials\" setting must also be set to \"true\"."
