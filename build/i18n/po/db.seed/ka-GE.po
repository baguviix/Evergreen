# id::coust.label__acq.default_owning_lib_for_auto_lids_strategy
#: 950.data.seed-values.sql:3309
msgid "How to set default owning library for auto-created line item items"
msgstr "როგორ დავაყენოთ ნაგულისხმევი მფლობელი ბიბლიოთეკა ავტომატურად შექმნილი ხაზის ერთეულებისთვის"

# id::coust.description__acq.default_owning_lib_for_auto_lids_strategy
#: 950.data.seed-values.sql:3312
msgid ""
"Strategy to use when setting the default owning library for line item items "
"that are auto-created due to the provider's default copy count being set. "
"Valid values are \"workstation\" to use the workstation library, \"blank\" "
"to leave it blank, and \"use_setting\" to use the \"Default owning library "
"for auto-created line item items\" setting. If not set, the workstation "
"library will be used."
msgstr "სტრატეგია, რომელიც გამოიყენება ნაგულისხმევი მფლობელის ბიბლიოთეკის დაყენებისას ხაზის ერთეულებისთვის, რომლებიც ავტომატურად იქმნება პროვაიდერის ნაგულისხმევი ასლების რაოდენობის დაყენების გამო. მოქმედი მნიშვნელობებია \"სამუშაო სადგური\" სამუშაო სადგურის ბიბლიოთეკის გამოსაყენებლად, \"ცარიელი\" ცარიელის დასატოვებლად და \"use_setting\" გამოსაყენებლად \"ნაგულისხმევი მფლობელის ბიბლიოთეკა ავტო-შექმნილი ხაზის ერთეულებისთვის\" პარამეტრის გამოსაყენებლად. თუ არ არის დაყენებული, გამოყენებული იქნება სამუშაო სადგურის ბიბლიოთეკა."

# id::coust.label__acq.default_owning_lib_for_auto_lids
#: 950.data.seed-values.sql:3317
