msgid ""
"When true, the patron summary sidebar will collapse after a new patron sub-"
"interface is selected."
msgstr "როდესაც true, პატრონის შემაჯამებელი გვერდითი ზოლი იშლება მას შემდეგ, რაც შეირჩევა ახალი მფარველი ქვეინტერფეისი."

# id::coust.label__circ.block_renews_for_holds
#: 950.data.seed-values.sql:3602
msgid "Block Renewal of Items Needed for Holds"
msgstr "ბლოკირებისთვის საჭირო ნივთების განახლება"

# id::coust.description__circ.block_renews_for_holds
#: 950.data.seed-values.sql:3605
msgid ""
"When an item could fulfill a hold, do not allow the current patron to renew"
msgstr "როდესაც ნივთს შეუძლია შეასრულოს დაკავება, არ მისცეთ ამჟამინდელ პატრონს განახლების უფლება"

# id::coust.label__circ.booking_reservation.default_elbow_room
#: 950.data.seed-values.sql:3611
msgid "Booking elbow room"
msgstr "იდაყვის ოთახის დაჯავშნა"

# id::coust.description__circ.booking_reservation.default_elbow_room
#: 950.data.seed-values.sql:3614
msgid ""
"Elbow room specifies how far in the future you must make a reservation on an"
" item if that item will have to transit to reach its pickup location.  It "
"secondarily defines how soon a reservation on a given item must start before"
" the check-in process will opportunistically capture it for the reservation "
"shelf."
msgstr "იდაყვის ოთახი განსაზღვრავს, თუ რა მანძილზე უნდა გააკეთოთ დაჯავშნა საქონელზე, თუ ამ ნივთს მოუწევს ტრანზიტი მისი აღების ადგილამდე მისასვლელად.  ის მეორად განსაზღვრავს, თუ რამდენ ხანში უნდა დაიწყოს დაჯავშნა მოცემულ ნივთზე, სანამ შემოწმების პროცესი ოპორტუნისტურად აითვისებს მას დაჯავშნის თაროზე."

# id::coust.label__circ.charge_lost_on_zero
# id::coust.description__circ.charge_lost_on_zero
#: 950.data.seed-values.sql:3620 950.data.seed-values.sql:3623
msgid "Charge lost on zero"
msgstr "დამუხტვა დაიკარგა ნულზე"

# id::coust.label__circ.charge_on_damaged
# id::coust.description__circ.charge_on_damaged
#: 950.data.seed-values.sql:3629 950.data.seed-values.sql:3632
msgid "Charge item price when marked damaged"
msgstr "დააკისრეთ პროდუქტის ფასი, როდესაც აღინიშნება დაზიანებულად"

# id::coust.label__circ.checkout_auto_renew_age
#: 950.data.seed-values.sql:3638
msgid "Checkout auto renew age"
msgstr "შეამოწმეთ ავტომატური განახლების ასაკი"

# id::coust.description__circ.checkout_auto_renew_age
#: 950.data.seed-values.sql:3641
msgid ""
"When an item has been checked out for at least this amount of time, an "
"attempt to check out the item to the patron that it is already checked out "
"to will simply renew the circulation"
msgstr "როდესაც საქონელი შემოწმებულია სულ მცირე ამ დროის განმავლობაში, მცდელობა, რომ საქონელი გადაამოწმოთ პატრონს, სადაც ის უკვე შემოწმებულია, უბრალოდ განაახლებს ტირაჟს."

# id::coust.label__circ.checkout_fills_related_hold
#: 950.data.seed-values.sql:3647
msgid "Checkout Fills Related Hold"
msgstr "შეკვეთა ავსებს Related Hold"

# id::coust.description__circ.checkout_fills_related_hold
#: 950.data.seed-values.sql:3650
msgid ""
"When a patron checks out an item and they have no holds that directly target"
" the item, the system will attempt to find a hold for the patron that could "
"be fulfilled by the checked out item and fulfills it"
msgstr "როდესაც პატრონი ამოწმებს ნივთს და მათ არ აქვთ სათავსოები, რომლებიც პირდაპირ მიზნად ისახავს ნივთს, სისტემა შეეცდება მოძებნოს პატრონისთვის დაკავება, რომელიც შეიძლება შესრულდეს შემოწმებული ნივთის მიერ და ასრულებს მას"

# id::coust.label__circ.checkout_fills_related_hold_exact_match_only
#: 950.data.seed-values.sql:3656
msgid "Checkout Fills Related Hold On Valid Copy Only"
msgstr "შეკვეთის შევსება დაკავშირებულია დაელოდეთ მხოლოდ მოქმედ ასლს"

# id::coust.description__circ.checkout_fills_related_hold_exact_match_only
#: 950.data.seed-values.sql:3659
msgid ""
"When filling related holds on checkout only match on items that are valid "
"for opportunistic capture for the hold. Without this set a Title or Volume "
"hold could match when the item is not holdable. With this set only holdable "
"items will match."
msgstr "თანხების შევსებისას ანგარიშსწორებისას ემთხვევა მხოლოდ იმ ნივთებს, რომლებიც მოქმედებს ოპორტუნისტული დაჭერისთვის. ამ ნაკრების გარეშე, სათაური ან მოცულობის შეკავება შეიძლება ემთხვეოდეს, როდესაც ელემენტი არ არის შესანახი. ამ ნაკრებით მხოლოდ შესანახი ნივთები ემთხვევა."

# id::coust.label__circ.claim_never_checked_out.mark_missing
#: 950.data.seed-values.sql:3665
msgid "Claim Never Checked Out: Mark copy as missing"
msgstr "პრეტენზია არასოდეს შემოწმებულა: მონიშნეთ ასლი დაკარგული"

# id::coust.description__circ.claim_never_checked_out.mark_missing
#: 950.data.seed-values.sql:3668
msgid ""
"When a circ is marked as claims-never-checked-out, mark the copy as missing"
msgstr "როდესაც წრე მონიშნულია, როგორც პრეტენზიები-არასდროს შემოწმებული, მონიშნეთ ასლი დაკარგული"

# id::coust.label__circ.claim_return.copy_status
#: 950.data.seed-values.sql:3674
msgid "Claim Return Copy Status"
msgstr "მოითხოვეთ დაბრუნების ასლის სტატუსი"

# id::coust.description__circ.claim_return.copy_status
#: 950.data.seed-values.sql:3677
msgid ""
"Claims returned copies are put into this status.  Default is to leave the "
"copy in the Checked Out status"
msgstr "პრეტენზიები დაბრუნებული ასლები მოთავსებულია ამ სტატუსში.  ნაგულისხმევი არის ასლის დატოვება შემოწმების სტატუსში"

# id::coust.label__circ.damaged.void_ovedue
#: 950.data.seed-values.sql:3683
msgid "Mark item damaged voids overdues"
msgstr "მონიშნეთ დაზიანებული ნივთის ვადაგადაცილებული ვადა"

# id::coust.description__circ.damaged.void_ovedue
#: 950.data.seed-values.sql:3686
msgid ""
"When an item is marked damaged, overdue fines on the most recent circulation"
" are voided."
msgstr "როდესაც ნივთი აღინიშნება დაზიანებულად, ბოლო ტირაჟზე ვადაგადაცილებული ჯარიმები უქმდება."

# id::coust.label__circ.damaged_item_processing_fee
# id::coust.description__circ.damaged_item_processing_fee
#: 950.data.seed-values.sql:3692 950.data.seed-values.sql:3695
msgid "Charge processing fee for damaged items"
msgstr "დააკისრეთ დამუშავების საფასური დაზიანებული ნივთებისთვის"

# id::coust.label__circ.do_not_tally_claims_returned
#: 950.data.seed-values.sql:3701
msgid ""
"Do not include outstanding Claims Returned circulations in lump sum tallies "
"in Patron Display."
msgstr "არ შეიტანოთ გადაუხდელი პრეტენზიები დაბრუნებული ტირაჟები ერთჯერადი თანხის ანგარიშებში პატრონის ჩვენებაზე."

# id::coust.description__circ.do_not_tally_claims_returned
#: 950.data.seed-values.sql:3704
msgid ""
"In the Patron Display interface, the number of total active circulations for"
" a given patron is presented in the Summary sidebar and underneath the Items"
" Out navigation button.  This setting will prevent Claims Returned "
"circulations from counting toward these tallies."
msgstr "პატრონის ჩვენების ინტერფეისში მოცემული პატრონისთვის მთლიანი აქტიური ტირაჟების რაოდენობა წარმოდგენილია შემაჯამებელ გვერდითა ზოლში და ნავიგაციის ღილაკების ქვეშ.  ეს პარამეტრი ხელს შეუშლის დაბრუნებული ტირაჟების პრეტენზიების ჩათვლას ამ ანგარიშებში."

# id::coust.label__circ.tally_lost
#: 950.data.seed-values.sql:3710
msgid "Include Lost circulations in lump sum tallies in Patron Display."
msgstr "ჩართეთ დაკარგული ცირკულაციები ერთიან თანხებში მკითხველის ეკრანზე."

# id::coust.description__circ.tally_lost
#: 950.data.seed-values.sql:3715
msgid ""
"In the Patron Display interface, the number of total active circulations for"
" a given patron is presented in the Summary sidebar and underneath the Items"
" Out navigation button.  This setting will include Lost circulations as "
"counting toward these tallies."
msgstr "პატრონის ჩვენების ინტერფეისში მოცემული პატრონისთვის მთლიანი აქტიური ტირაჟების რაოდენობა წარმოდგენილია შემაჯამებელ გვერდითა ზოლში და ნავიგაციის ღილაკების ქვეშ.  ეს პარამეტრი მოიცავს დაკარგულ ტირაჟებს, როგორც ითვლის ამ ანგარიშებს."

# id::coust.label__circ.grace.extend
#: 950.data.seed-values.sql:3723
msgid "Auto-Extend Grace Periods"
msgstr "საშეღავათო პერიოდების ავტომატური გახანგრძლივება"

# id::coust.description__circ.grace.extend
#: 950.data.seed-values.sql:3726
msgid ""
"When enabled grace periods will auto-extend. By default this will be only "
"when they are a full day or more and end on a closed date, though other "
"options can alter this."
msgstr "როდესაც ჩართულია საშეღავათო პერიოდები ავტომატურად გაგრძელდება. ნაგულისხმევად ეს იქნება მხოლოდ მაშინ, როდესაც ისინი მთელი დღე ან მეტია და დასრულდება დახურულ თარიღზე, თუმცა სხვა ვარიანტებს შეუძლიათ შეცვალონ ეს."

# id::coust.label__circ.grace.extend.all
#: 950.data.seed-values.sql:3732
msgid "Auto-Extending Grace Periods extend for all closed dates"
msgstr "ავტომატური გახანგრძლივების საშეღავათო პერიოდები ვრცელდება ყველა დახურულ თარიღზე"

# id::coust.description__circ.grace.extend.all
#: 950.data.seed-values.sql:3735
msgid ""
"If enabled and Grace Periods auto-extending is turned on grace periods will "
"extend past all closed dates they intersect, within hard-coded limits. This "
"basically becomes \"grace periods can only be consumed by closed dates\"."
msgstr "თუ ჩართულია და საშეღავათო პერიოდების ავტომატური გახანგრძლივება ჩართულია, საშეღავათო პერიოდი გაგრძელდება ყველა დახურული თარიღის შემდეგ, რომელიც მათ კვეთს, მყარი კოდირებული ლიმიტების ფარგლებში. ეს ძირითადად ხდება „შეღავათიანი პერიოდის მოხმარება მხოლოდ დახურული თარიღებით“."

# id::coust.label__circ.grace.extend.into_closed
#: 950.data.seed-values.sql:3741
msgid "Auto-Extending Grace Periods include trailing closed dates"
msgstr "ავტომატური გახანგრძლივების საშეღავათო პერიოდები მოიცავს დახურულ თარიღებს"

# id::coust.description__circ.grace.extend.into_closed
#: 950.data.seed-values.sql:3744
msgid ""
"If enabled and Grace Periods auto-extending is turned on grace periods will "
"include closed dates that directly follow the last day of the grace period, "
"to allow a backdate into the closed dates to assume \"returned after hours "
"on the last day of the grace period, and thus still within it\" "
"automatically."
msgstr "თუ ჩართულია და საშეღავათო პერიოდების ავტომატური გახანგრძლივება ჩართულია, საშეღავათო პერიოდები მოიცავს დახურულ თარიღებს, რომლებიც უშუალოდ მოჰყვება საშეღავათო პერიოდის ბოლო დღეს, რათა დახურულ თარიღებში უკან დაბრუნებული თარიღები ავტომატურად ვივარაუდოთ \"საშეღავათო პერიოდის ბოლო დღის საათების შემდეგ და, შესაბამისად, ისევ მის ფარგლებში\"."

# id::coust.label__circ.hold_boundary.hard
#: 950.data.seed-values.sql:3750
msgid "Hard boundary"
msgstr "მძიმე საზღვარი"

# id::coust.description__circ.hold_boundary.hard
#: 950.data.seed-values.sql:3753
msgid "Holds: Hard boundary"
msgstr "ფლობს: მძიმე საზღვარს"

# id::coust.label__circ.hold_boundary.soft
#: 950.data.seed-values.sql:3759
msgid "Soft boundary"
msgstr "რბილი საზღვარი"

# id::coust.description__circ.hold_boundary.soft
#: 950.data.seed-values.sql:3762
msgid "Holds: Soft boundary"
msgstr "ფლობს: რბილი საზღვარი"

# id::coust.label__circ.hold_expire_alert_interval
#: 950.data.seed-values.sql:3768
msgid "Expire Alert Interval"
msgstr "ვადის გასვლის გაფრთხილების ინტერვალი"

# id::coust.description__circ.hold_expire_alert_interval
#: 950.data.seed-values.sql:3771
msgid ""
"Amount of time before a hold expires at which point the patron should be "
"alerted. Examples: \"5 days\", \"1 hour\""
msgstr "ვადის გასვლამდე დრო, რა დროსაც პატრონი უნდა იყოს გაფრთხილებული. მაგალითები: \"5 დღე\", \"1 საათი\""

# id::coust.label__circ.hold_expire_interval
#: 950.data.seed-values.sql:3777
msgid "Expire Interval"
msgstr "ვადის გასვლის ინტერვალი"

# id::coust.description__circ.hold_expire_interval
#: 950.data.seed-values.sql:3780
msgid ""
"Amount of time after a hold is placed before the hold expires.  Example "
"\"100 days\""
msgstr "ვადის გასვლამდე ვადის გასვლამდე ვადის გასვლის შემდეგ.  მაგალითი \"100 დღე\""

# id::coust.label__circ.hold_shelf_status_delay
#: 950.data.seed-values.sql:3786
msgid "Hold Shelf Status Delay"
msgstr "შეაჩერე შელფის სტატუსის დაგვიანება"

# id::coust.description__circ.hold_shelf_status_delay
#: 950.data.seed-values.sql:3789
msgid ""
"The purpose is to provide an interval of time after an item goes into the "
"on-holds-shelf status before it appears to patrons that it is actually on "
"the holds shelf.  This gives staff time to process the item before it shows "
"as ready-for-pickup. Examples: \"5 days\", \"1 hour\""
msgstr "მიზანი არის დროის ინტერვალის მიწოდება მას შემდეგ, რაც ნივთი შენახულ სტატუსში შედის, სანამ პატრონებს ეჩვენებათ, რომ ის რეალურად თაროზეა.  ეს თანამშრომლებს აძლევს დროს, რომ დაამუშავონ ნივთი, სანამ ის გამოჩნდება, როგორც მზა ასაღებად. მაგალითები: \"5 დღე\", \"1 საათი\""

# id::coust.label__circ.hold_stalling.soft
#: 950.data.seed-values.sql:3795
msgid "Soft stalling interval"
msgstr "რბილი შეფერხების ინტერვალი"

# id::coust.description__circ.hold_stalling.soft
#: 950.data.seed-values.sql:3798
msgid ""
"How long to wait before allowing opportunistic capture of holds with a "
"pickup library other than the context item's circulating library"
msgstr "რამდენი ხანი უნდა ველოდოთ, სანამ კონტექსტური ერთეულის მოცირკულირე ბიბლიოთეკის გარდა ოპორტუნისტული აღების უფლებას შევძლებთ პიკაპის ბიბლიოთეკით"

# id::coust.label__circ.pickup_hold_stalling.soft
#: 950.data.seed-values.sql:3804
msgid "Pickup Library Soft stalling interval"
msgstr "პიკაპის ბიბლიოთეკა რბილი შეფერხების ინტერვალი"

# id::coust.description__circ.pickup_hold_stalling.soft
#: 950.data.seed-values.sql:3807
msgid ""
"When set for the pickup library, this specifies that for holds with a "
"request time age smaller than this interval only items scanned at the pickup"
" library can be opportunistically captured. Example \"5 days\". This setting"
" takes precedence over \"Soft stalling interval\" (circ.hold_stalling.soft) "
"when the interval is in force."
msgstr "პიკაპის ბიბლიოთეკისთვის დაყენებისას, ეს მიუთითებს, რომ ამ ინტერვალზე მცირე მოთხოვნის დროის ასაკის მქონე მფლობელებისთვის შესაძლებელია მხოლოდ პიკაპის ბიბლიოთეკაში სკანირებული ერთეულების ოპორტუნისტული აღბეჭდვა. მაგალითი \"5 დღე\". ეს პარამეტრი უპირატესობას ანიჭებს \"რბილი შეფერხების ინტერვალს\" (circ.hold_stalling.soft), როდესაც ინტერვალი ძალაშია."

# id::coust.label__circ.pickup_hold_stalling.hard
#: 950.data.seed-values.sql:3813
msgid "Pickup Library Hard stalling interval"
msgstr "პიკაპის ბიბლიოთეკა მძიმე გაჩერების ინტერვალი"

# id::coust.description__circ.pickup_hold_stalling.hard
#: 950.data.seed-values.sql:3816
msgid ""
"When set for the pickup library, this specifies that no items with a "
"calculated proximity greater than 0 from the pickup library can be directly "
"targeted for this time period if there are local available copies.  Example "
"\"3 days\"."
msgstr "პიკაპის ბიბლიოთეკისთვის დაყენებისას, ეს მიუთითებს, რომ არცერთი ელემენტი, რომლის გამოთვლილი სიახლოვე 0-ზე მეტია პიკაპის ბიბლიოთეკიდან, არ შეიძლება იყოს პირდაპირ მიზნობრივი ამ პერიოდისთვის, თუ არსებობს ადგილობრივი ხელმისაწვდომი ასლები.  მაგალითი \"3 დღე\"."

# id::coust.label__circ.holds.age_protect.active_date
#: 950.data.seed-values.sql:3822
msgid "Use Active Date for Age Protection"
msgstr "გამოიყენეთ აქტიური თარიღი ასაკის დაცვისთვის"

# id::coust.description__circ.holds.age_protect.active_date
#: 950.data.seed-values.sql:3825
msgid ""
"When calculating age protection rules use the active date instead of the "
"creation date."
msgstr "ასაკის დაცვის წესების გაანგარიშებისას გამოიყენეთ აქტიური თარიღი შექმნის თარიღის ნაცვლად."

# id::coust.label__circ.holds.behind_desk_pickup_supported
#: 950.data.seed-values.sql:3831
msgid "Behind Desk Pickup Supported"
msgstr "მხარდაჭერილია სამაგიდო პიკაპის უკან"

# id::coust.description__circ.holds.behind_desk_pickup_supported
#: 950.data.seed-values.sql:3834
msgid ""
"If a branch supports both a public holds shelf and behind-the-desk pickups, "
"set this value to true.  This gives the patron the option to enable behind-"
"the-desk pickups for their holds"
msgstr "თუ ფილიალი მხარს უჭერს როგორც თაროზე, ასევე სამუშაო მაგიდის მიღმა პიკაპებს, დააყენეთ ეს მნიშვნელობა true.  ეს აძლევს პატრონს შესაძლებლობას, ჩართოს სამუშაო მაგიდის მიღმა პიკაპები"

# id::coust.label__circ.holds.canceled.display_age
#: 950.data.seed-values.sql:3840
msgid "Canceled holds/requests display age"
msgstr "გაუქმებული შეფერხებები/მოთხოვნის ჩვენება ასაკი"

# id::coust.description__circ.holds.canceled.display_age
#: 950.data.seed-values.sql:3843
msgid ""
"Show all canceled entries in patron holds and patron acquisition requests "
"interfaces that were canceled within this amount of time"
msgstr "აჩვენეთ ყველა გაუქმებული ჩანაწერი მფარველების მფლობელობაში და პატრონის შეძენის მოთხოვნის ინტერფეისებში, რომლებიც გაუქმდა ამ დროის განმავლობაში"

# id::coust.label__circ.holds.canceled.display_count
#: 950.data.seed-values.sql:3849
msgid "Canceled holds/requests display count"
msgstr "გაუქმებული შეფერხებების/მოთხოვნის ჩვენების რაოდენობა"

# id::coust.description__circ.holds.canceled.display_count
#: 950.data.seed-values.sql:3852
msgid ""
"How many canceled entries to show in patron holds and patron acquisition "
"requests interfaces"
msgstr "რამდენი გაუქმებული ჩანაწერი უნდა აჩვენოს პატრონის მფლობელობაში და პატრონის შეძენის მოთხოვნის ინტერფეისებში"

# id::coust.label__circ.holds.clear_shelf.copy_status
#: 950.data.seed-values.sql:3858
msgid "Clear shelf copy status"
msgstr "თაროზე ასლის სტატუსის გასუფთავება"

# id::coust.description__circ.holds.clear_shelf.copy_status
#: 950.data.seed-values.sql:3861
msgid ""
"Any copies that have not been put into reshelving, in-transit, or on-holds-"
"shelf (for a new hold) during the clear shelf process will be put into this "
"status.  This is basically a purgatory status for copies waiting to be "
"pulled from the shelf and processed by hand"
msgstr "ნებისმიერი ასლი, რომელიც არ იქნა შენახული თაროში, ტრანზიტში ან შენახულ თაროზე (ახალი შენახვისთვის) თაროზე გასუფთავების პროცესის დროს, დაიდება ამ სტატუსში.  ეს ძირითადად განსაწმენდელი სტატუსია ასლებისთვის, რომლებიც ელოდება თაროდან ამოღებას და ხელით დამუშავებას"

# id::coust.label__circ.holds.default_estimated_wait_interval
#: 950.data.seed-values.sql:3867
msgid "Default Estimated Wait"
msgstr "ნაგულისხმევი სავარაუდო ლოდინი"

# id::coust.description__circ.holds.default_estimated_wait_interval
#: 950.data.seed-values.sql:3870
msgid ""
"When predicting the amount of time a patron will be waiting for a hold to be"
" fulfilled, this is the default estimated length of time to assume an item "
"will be checked out. Examples: \"3 weeks\", \"7 days\""
msgstr "როდესაც პროგნოზირებთ იმ დროის ოდენობას, რომელსაც პატრონი დაელოდება შეკავების შესრულებას, ეს არის ნაგულისხმევი სავარაუდო დრო, რომ ვივარაუდოთ, რომ ნივთი იქნება შემოწმებული. მაგალითები: \"3 კვირა\", \"7 დღე\""

# id::coust.label__circ.holds.default_shelf_expire_interval
#: 950.data.seed-values.sql:3876
msgid "Default hold shelf expire interval"
msgstr "ნაგულისხმევი ჯავშნის თაროს ვადის გასვლის ინტერვალი"

# id::coust.description__circ.holds.default_shelf_expire_interval
#: 950.data.seed-values.sql:3879
msgid ""
"The amount of time an item will be held on the shelf before the hold "
"expires. For example: \"2 weeks\" or \"5 days\""
msgstr "დრო რამდენი დრო იქნება ნივთის შენახვა თაროზე შენახვის ვადის გასვლამდე. მაგალითად: \"2 კვირა\" ან \"5 დღე\""

# id::coust.label__circ.holds.expired_patron_block
# id::coust.description__circ.holds.expired_patron_block
#: 950.data.seed-values.sql:3885 950.data.seed-values.sql:3888
msgid "Block hold request if hold recipient privileges have expired"
msgstr "შეჩერების მოთხოვნის დაბლოკვა, თუ დაკავების მიმღების პრივილეგიები ამოიწურა"

# id::coust.label__circ.renew.expired_patron_allow
#: 950.data.seed-values.sql:3894
msgid "Allow renewal request if renewal recipient privileges have expired"
msgstr "განახლების მოთხოვნის დაშვება, თუ განახლების მიმღების პრივილეგიები ამოიწურა"

# id::coust.description__circ.renew.expired_patron_allow
#: 950.data.seed-values.sql:3897
msgid ""
"If enabled, users within the org unit who are expired may still renew items."
msgstr "თუ ჩართულია, ორგანული ერთეულის წევრებს, რომლებსაც ვადა გაუვიდა, შეუძლიათ კვლავ განაახლონ ერთეულები."

# id::coust.label__circ.holds.hold_has_copy_at.alert
#: 950.data.seed-values.sql:3903
msgid "Has Local Copy Alert"
msgstr "აქვს ლოკალური ასლის გაფრთხილება"

# id::coust.description__circ.holds.hold_has_copy_at.alert
#: 950.data.seed-values.sql:3906
msgid ""
"If there is an available copy at the requesting library that could fulfill a"
" hold during hold placement time, alert the patron"
msgstr "თუ მოთხოვნის ბიბლიოთეკაში არის ხელმისაწვდომი ასლი, რომელიც შეიძლება შეასრულოს შეკავება შეჩერების დროს, გააფრთხილეთ პატრონი"

# id::coust.label__circ.holds.hold_has_copy_at.block
#: 950.data.seed-values.sql:3912
msgid "Has Local Copy Block"
msgstr "აქვს ლოკალური ასლის ბლოკი"

# id::coust.description__circ.holds.hold_has_copy_at.block
#: 950.data.seed-values.sql:3915
msgid ""
"If there is an available copy at the requesting library that could fulfill a"
" hold during hold placement time, do not allow the hold to be placed"
msgstr "თუ მოთხოვნის ბიბლიოთეკაში არის ხელმისაწვდომი ასლი, რომელსაც შეუძლია შეასრულოს შეკავება შეკავების დროს, არ დაუშვათ სამაგრის განთავსება"

# id::coust.label__circ.holds.max_org_unit_target_loops
#: 950.data.seed-values.sql:3921
msgid "Maximum library target attempts"
msgstr "ბიბლიოთეკის მიზნობრივი მცდელობების მაქსიმალური რაოდენობა"

# id::coust.description__circ.holds.max_org_unit_target_loops
#: 950.data.seed-values.sql:3924
msgid ""
"When this value is set and greater than 0, the system will only attempt to "
"find a copy at each possible branch the configured number of times"
msgstr "როდესაც ეს მნიშვნელობა დაყენებულია და 0-ზე მეტია, სისტემა შეეცდება მოიძიოს ასლი თითოეულ შესაძლო ფილიალში, კონფიგურირებული რამდენჯერმე"

# id::coust.label__circ.holds.min_estimated_wait_interval
#: 950.data.seed-values.sql:3930
msgid "Minimum Estimated Wait"
msgstr "მინიმალური სავარაუდო მოლოდინი"

# id::coust.description__circ.holds.min_estimated_wait_interval
#: 950.data.seed-values.sql:3933
msgid ""
"When predicting the amount of time a patron will be waiting for a hold to be"
" fulfilled, this is the minimum estimated length of time to assume an item "
"will be checked out. Examples: \"2 weeks\", \"5 days\""
msgstr "როდესაც პროგნოზირებთ იმ დროის ოდენობას, რომელსაც პატრონი ელოდება დაკავების შესრულებას, ეს არის დროის მინიმალური სავარაუდო ხანგრძლივობა იმისთვის, რომ ვივარაუდოთ, რომ ნივთის შემოწმება მოხდება. მაგალითები: \"2 კვირა\", \"5 დღე\""

# id::coust.label__circ.holds.org_unit_target_weight
#: 950.data.seed-values.sql:3939
msgid "Org Unit Target Weight"
msgstr "ორგანული ერთეულის სამიზნე წონა"

# id::coust.description__circ.holds.org_unit_target_weight
#: 950.data.seed-values.sql:3942
msgid ""
"Org Units can be organized into hold target groups based on a weight.  "
"Potential copies from org units with the same weight are chosen at random."
msgstr "ორგანული ერთეულები შეიძლება დაიყოს სამიზნე ჯგუფებად წონის მიხედვით.  პოტენციური ასლები ორგანული ერთეულებიდან იმავე წონით შეირჩევა შემთხვევით."

# id::coust.label__circ.holds.recall_fine_rules
#: 950.data.seed-values.sql:3948
msgid "An array of fine amount, fine interval, and maximum fine."
msgstr "ჯარიმის თანხის, ჯარიმის ინტერვალისა და მაქსიმალური ჯარიმის მასივი."

# id::coust.description__circ.holds.recall_fine_rules
#: 950.data.seed-values.sql:3951
msgid ""
"Recalls: An array of fine amount, fine interval, and maximum fine. For "
"example, to specify a new fine rule of $5.00 per day, with a maximum fine of"
" $50.00, use: [5.00,\"1 day\",50.00]"
msgstr "იხსენებს: ჯარიმის თანხის, ჯარიმის ინტერვალისა და მაქსიმალური ჯარიმის მასივი. მაგალითად, ახალი ჯარიმის წესის დასაზუსტებლად $5.00 დღეში, მაქსიმალური ჯარიმა $50.00, გამოიყენეთ: [5.00,\"1 day\",50.00]"

# id::coust.label__circ.holds.recall_return_interval
#: 950.data.seed-values.sql:3957
msgid "Truncated loan period."
msgstr "შემცირებული სესხის პერიოდი."

# id::coust.description__circ.holds.recall_return_interval
#: 950.data.seed-values.sql:3960
msgid ""
"Recalls: When a recall is triggered, this defines the adjusted loan period "
"for the item. For example, \"4 days\" or \"1 week\"."
msgstr "გახსენება: როდესაც გამოხმაურება ხდება, ეს განსაზღვრავს საქონლის სესხის კორექტირებულ პერიოდს. მაგალითად, \"4 დღე\" ან \"1 კვირა\"."

# id::coust.label__circ.holds.recall_threshold
#: 950.data.seed-values.sql:3966
msgid "Circulation duration that triggers a recall."
msgstr "მიმოქცევის ხანგრძლივობა, რომელიც იწვევს გახსენებას."

# id::coust.description__circ.holds.recall_threshold
#: 950.data.seed-values.sql:3969
msgid ""
"Recalls: A hold placed on an item with a circulation duration longer than "
"this will trigger a recall. For example, \"14 days\" or \"3 weeks\"."
msgstr "იხსენებს: ნივთზე დაჭერა, რომლის მიმოქცევის ხანგრძლივობა აღემატება მას, გამოიწვევს გაწვევას. მაგალითად, \"14 დღე\" ან \"3 კვირა\"."

# id::coust.label__circ.holds.target_skip_me
#: 950.data.seed-values.sql:3975
msgid "Skip For Hold Targeting"
msgstr "Skip for Hold Targeting"

# id::coust.description__circ.holds.target_skip_me
#: 950.data.seed-values.sql:3978
msgid "When true, don't target any copies at this org unit for holds"
msgstr "როდესაც ჭეშმარიტია, ნუ მიმართავთ ამ ორგანულ ერთეულზე ასლებს შეჩერებისთვის"

# id::coust.label__circ.holds.uncancel.reset_request_time
#: 950.data.seed-values.sql:3984
msgid "Reset request time on un-cancel"
msgstr "გაუქმებისას მოთხოვნის დროის გადატვირთვა"

# id::coust.description__circ.holds.uncancel.reset_request_time
#: 950.data.seed-values.sql:3987
msgid ""
"When a hold is uncanceled, reset the request time to push it to the end of "
"the queue"
msgstr "როდესაც დაკავება გაუქმებულია, გადააყენეთ მოთხოვნის დრო, რათა ის რიგის ბოლომდე მიიყვანოთ"

# id::coust.label__circ.holds_fifo
#: 950.data.seed-values.sql:3993
msgid "FIFO"
msgstr "FIFO"

# id::coust.description__circ.holds_fifo
#: 950.data.seed-values.sql:3996
msgid "Force holds to a more strict First-In, First-Out capture"
msgstr "Force იცავს უფრო მკაცრ „პირველი შეყვანის“, „პირველი გამოსვლის“ დაჭერას"

# id::coust.label__circ.item_checkout_history.max
#: 950.data.seed-values.sql:4002
msgid "Maximum previous checkouts displayed"
msgstr "ნაჩვენებია წინა გადარიცხვების მაქსიმალური რაოდენობა"

# id::coust.description__circ.item_checkout_history.max
#: 950.data.seed-values.sql:4005
msgid ""
"This is the maximum number of previous circulations the staff client will "
"display when investigating item details"
msgstr "ეს არის წინა ტირაჟების მაქსიმალური რაოდენობა, რომელსაც პერსონალის კლიენტი აჩვენებს ნივთის დეტალების შესწავლისას"

# id::coust.label__circ.lost.generate_overdue_on_checkin
#: 950.data.seed-values.sql:4011
msgid "Lost Checkin Generates New Overdues"
msgstr "დაკარგული რეგისტრაცია წარმოქმნის ახალ ვადაგადაცილებულ ვადას"

# id::coust.description__circ.lost.generate_overdue_on_checkin
#: 950.data.seed-values.sql:4014
msgid ""
"Enabling this setting causes retroactive creation of not-yet-existing "
"overdue fines on lost item checkin, up to the point of checkin time (or max "
"fines is reached).  This is different than \"restore overdue on lost\", "
"because it only creates new overdue fines.  Use both settings together to "
"get the full complement of overdue fines for a lost item"
msgstr "ამ პარამეტრის ჩართვა იწვევს დაკარგული ნივთის რეგისტრაციაზე ჯერ არარსებული ვადაგადაცილებული ჯარიმების რეტროაქტიულ შექმნას შემოწმების დრომდე (ან მაქსიმუმ ჯარიმების მიღწევამდე).  ეს განსხვავდება „დაკარგულზე ვადაგადაცილების აღდგენაზე“, რადგან ის მხოლოდ ახალ ვადაგადაცილებულ ჯარიმებს ქმნის.  გამოიყენეთ ორივე პარამეტრი ერთად, რათა მიიღოთ ვადაგადაცილებული ჯარიმები დაკარგული ნივთისთვის"

# id::coust.label__circ.lost_immediately_available
#: 950.data.seed-values.sql:4020
msgid "Lost items usable on checkin"
msgstr "დაკარგული ნივთები გამოსაყენებელია რეგისტრაციისას"

# id::coust.description__circ.lost_immediately_available
#: 950.data.seed-values.sql:4023
msgid "Lost items are usable on checkin instead of going 'home' first"
msgstr "დაკარგული ნივთების გამოყენება შესაძლებელია რეგისტრაციისას, ნაცვლად იმისა, რომ ჯერ „სახლში“ წახვიდეთ"

# id::coust.label__circ.max_accept_return_of_lost
#: 950.data.seed-values.sql:4038
msgid "Void lost max interval"
msgstr "დაკარგული მაქსიმალური ინტერვალის გაუქმება"

# id::coust.description__circ.max_accept_return_of_lost
#: 950.data.seed-values.sql:4041
msgid ""
"Items that have been lost this long will not result in voided billings when "
"returned.  E.g. '6 months'"
msgstr "ნივთები, რომლებიც ამ ხნის განმავლობაში დაიკარგა, უკან დაბრუნებისას არ გამოიწვევს ბილინგის გაუქმებას.  მაგ. \"6 თვე\""

# id::coust.label__circ.max_fine.cap_at_price
#: 950.data.seed-values.sql:4047
msgid "Cap Max Fine at Item Price"
msgstr "cap max ჯარიმა ნივთის ფასში"

# id::coust.description__circ.max_fine.cap_at_price
#: 950.data.seed-values.sql:4050
msgid ""
"This prevents the system from charging more than the item price in overdue "
"fines"
msgstr "ეს ხელს უშლის სისტემას ვადაგადაცილებული ჯარიმების საქონლის ფასზე მეტი დარიცხვისგან"

# id::coust.label__circ.max_patron_claim_return_count
#: 950.data.seed-values.sql:4056
msgid "Max Patron Claims Returned Count"
msgstr "მაქს მკითხველის პრეტენზიების დაბრუნებული რაოდენობა"

# id::coust.description__circ.max_patron_claim_return_count
#: 950.data.seed-values.sql:4059
msgid ""
"When this count is exceeded, a staff override is required to mark the item "
"as claims returned"
msgstr "როდესაც ეს რაოდენობა გადააჭარბებს, საჭიროა პერსონალის უგულებელყოფა ნივთის დაბრუნებულ პრეტენზიად აღსანიშნავად"

# id::coust.label__circ.missing_pieces.copy_status
#: 950.data.seed-values.sql:4065
msgid "Item Status for Missing Pieces"
msgstr "ელემენტის სტატუსი დაკარგული ნაწილებისთვის"

# id::coust.description__circ.missing_pieces.copy_status
#: 950.data.seed-values.sql:4068
msgid ""
"This is the Item Status to use for items that have been marked or scanned as"
" having Missing Pieces.  In the absence of this setting, the Damaged status "
"is used."
msgstr "ეს არის ერთეულის სტატუსი, რომელიც გამოიყენება იმ ნივთებისთვის, რომლებიც მონიშნულია ან სკანირებულია, როგორც დაკარგული ცალი.  ამ პარამეტრის არარსებობის შემთხვევაში გამოიყენება დაზიანებული სტატუსი."

# id::coust.label__circ.obscure_dob
#: 950.data.seed-values.sql:4074
msgid "Obscure the Date of Birth field"
msgstr "დაფარეთ დაბადების თარიღის ველი"

# id::coust.description__circ.obscure_dob
#: 950.data.seed-values.sql:4077
msgid ""
"When true, the Date of Birth column in patron lists will default to Not "
"Visible, and in the Patron Summary sidebar the value will display as "
"<Hidden> unless the field label is clicked."
msgstr "როდესაც true, დაბადების თარიღის სვეტი პატრონების სიებში ნაგულისხმევად იქნება არ ჩანს, ხოლო პატრონის შეჯამების გვერდითა ზოლში მნიშვნელობა გამოჩნდება როგორც <Hidden>, თუ ველის ეტიკეტზე არ არის დაწკაპუნებული."

# id::coust.label__circ.offline.skip_checkin_if_newer_status_changed_time
#: 950.data.seed-values.sql:4083
msgid "Skip offline checkin if newer item Status Changed Time."
msgstr "გამოტოვეთ ხაზგარეშე შემოწმება, თუ ახალი ელემენტის სტატუსი შეიცვალა დრო."

# id::coust.description__circ.offline.skip_checkin_if_newer_status_changed_time
#: 950.data.seed-values.sql:4086
msgid ""
"Skip offline checkin transaction (raise exception when processing) if item "
"Status Changed Time is newer than the recorded transaction time.  WARNING: "
"The Reshelving to Available status rollover will trigger this."
msgstr "გამოტოვეთ ოფლაინ შემოწმების ტრანზაქცია (გამონაკლისის გაზრდა დამუშავებისას), თუ ელემენტის სტატუსის შეცვლილი დრო უფრო ახალია, ვიდრე ჩაწერილი ტრანზაქციის დრო.  WARNING: ხელახალი ხელმისაწვდომობის სტატუსის გადანაცვლება გამოიწვევს ამას."

# id::coust.label__circ.offline.skip_checkout_if_newer_status_changed_time
#: 950.data.seed-values.sql:4092
msgid "Skip offline checkout if newer item Status Changed Time."
msgstr "გამოტოვეთ ხაზგარეშე გადახდა, თუ უფრო ახალი ელემენტის სტატუსი შეიცვალა დრო."

# id::coust.description__circ.offline.skip_checkout_if_newer_status_changed_time
#: 950.data.seed-values.sql:4095
msgid ""
"Skip offline checkout transaction (raise exception when processing) if item "
"Status Changed Time is newer than the recorded transaction time.  WARNING: "
"The Reshelving to Available status rollover will trigger this."
msgstr "გამოტოვეთ ოფლაინ შეკვეთის ტრანზაქცია (გამონაკლისის გაზრდა დამუშავებისას), თუ ერთეულის სტატუსის შეცვლილი დრო უფრო ახალია, ვიდრე ჩაწერილი ტრანზაქციის დრო.  WARNING: ხელახალი ხელმისაწვდომობის სტატუსის გადანაცვლება გამოიწვევს ამას."

# id::coust.label__circ.offline.skip_renew_if_newer_status_changed_time
#: 950.data.seed-values.sql:4101
msgid "Skip offline renewal if newer item Status Changed Time."
msgstr "გამოტოვეთ ხაზგარეშე განახლება, თუ უფრო ახალი ელემენტის სტატუსი შეიცვალა დრო."

# id::coust.description__circ.offline.skip_renew_if_newer_status_changed_time
#: 950.data.seed-values.sql:4104
msgid ""
"Skip offline renewal transaction (raise exception when processing) if item "
"Status Changed Time is newer than the recorded transaction time.  WARNING: "
"The Reshelving to Available status rollover will trigger this."
msgstr "გამოტოვეთ ხაზგარეშე განახლების ტრანზაქცია (გამონაკლისის გაზრდა დამუშავებისას), თუ ელემენტის სტატუსის შეცვლის დრო უფრო ახალია, ვიდრე ჩაწერილი ტრანზაქციის დრო.  WARNING: ხელახალი ხელმისაწვდომობის სტატუსის გადანაცვლება გამოიწვევს ამას."

# id::coust.label__circ.offline.username_allowed
#: 950.data.seed-values.sql:4110
msgid "Offline: Patron Usernames Allowed"
msgstr "ხაზგარეშე: დამხმარე მომხმარებლის სახელები დაშვებულია"

# id::coust.description__circ.offline.username_allowed
#: 950.data.seed-values.sql:4113
msgid ""
"During offline circulations, allow patrons to identify themselves with "
"usernames in addition to barcode.  For this setting to work, a barcode "
"format must also be defined"
msgstr "ოფლაინ ტირაჟის დროს, ნება მიეცით პატრონებს, შტრიხკოდის გარდა, მომხმარებლის სახელებითაც იდენტიფიცირება.  იმისათვის, რომ ამ პარამეტრმა იმუშაოს, ასევე უნდა განისაზღვროს შტრიხკოდის ფორმატი"

# id::coust.label__circ.course_materials_opt_in
#: 950.data.seed-values.sql:4119
msgid "Opt Org Unit into the Course Materials Module"
msgstr "შეიყვანეთ ორგანიზაციული ერთეული კურსის მასალების მოდულში"

# id::coust.description__circ.course_materials_opt_in
#: 950.data.seed-values.sql:4123
msgid "If enabled, the Org Unit will utilize Course Material functionality."
msgstr "თუ ჩართულია, ორგანიზაციული ერთეული გამოიყენებს კურსის მასალის ფუნქციონირებას."

# id::coust.label__circ.course_materials_browse_by_instructor
#: 950.data.seed-values.sql:4130
msgid "Allow users to browse Courses by Instructor"
msgstr "ნება მიეცით მომხმარებლებს დაათვალიერონ კურსები ინსტრუქტორის მიხედვით"

# id::coust.description__circ.course_materials_browse_by_instructor
#: 950.data.seed-values.sql:4134
msgid ""
"If enabled, the Org Unit will allow OPAC users to browse Courses by "
"instructor name."
msgstr "თუ ჩართულია, ორგანიზაციული ერთეული OPAC მომხმარებლებს საშუალებას მისცემს დაათვალიერონ კურსები ინსტრუქტორის სახელით."

# id::coust.label__circ.course_materials_brief_record_bib_source
#: 950.data.seed-values.sql:4141
msgid "Bib source for brief records created in the course materials module"
msgstr "კურსის მასალების მოდულში შექმნილი მოკლე ჩანაწერების წყარო"

# id::coust.description__circ.course_materials_brief_record_bib_source
#: 950.data.seed-values.sql:4145
msgid ""
"The course materials module will use this bib source for any new brief "
"bibliographic records made inside that module. For best results, use a "
"transcendent bib source."
msgstr "კურსის მასალების მოდული გამოიყენებს ამ ბიბილო წყაროს ნებისმიერი ახალი მოკლე ბიბლიოგრაფიული ჩანაწერისთვის, რომელიც გაკეთებულია ამ მოდულის შიგნით. საუკეთესო შედეგისთვის გამოიყენეთ ტრანსცენდენტური ბიბის წყარო."

# id::coust.label__circ.password_reset_request_per_user_limit
#: 950.data.seed-values.sql:4153
msgid ""
"Maximum concurrently active self-serve password reset requests per user"
msgstr "მაქსიმალური ერთდროულად აქტიური თვითმომსახურების პაროლის გადატვირთვის მოთხოვნა თითო მომხმარებლისთვის"

# id::coust.description__circ.password_reset_request_per_user_limit
#: 950.data.seed-values.sql:4156
msgid ""
"When a user has more than this number of concurrently active self-serve "
"password reset requests for their account, prevent the user from creating "
"any new self-serve password reset requests until the number of active "
"requests for the user drops back below this number."
msgstr "როდესაც მომხმარებელს აქვს ამ რაოდენობის პარალელურად აქტიური თვითმომსახურების პაროლის გადატვირთვის მოთხოვნა მის ანგარიშზე, აკრძალეთ მომხმარებელს შექმნას რაიმე ახალი თვითმომსახურების პაროლის გადატვირთვის მოთხოვნა, სანამ მომხმარებლის აქტიური მოთხოვნის რაოდენობა არ დაიწევს ამ რიცხვის ქვემოთ."

# id::coust.label__circ.password_reset_request_requires_matching_email
# id::coust.description__circ.password_reset_request_requires_matching_email
#: 950.data.seed-values.sql:4162 950.data.seed-values.sql:4165
msgid "Require matching email address for password reset requests"
msgstr "მოითხოვეთ შესაბამისი ელფოსტის მისამართი პაროლის გადატვირთვის მოთხოვნებისთვის"

# id::coust.label__circ.password_reset_request_throttle
#: 950.data.seed-values.sql:4171
msgid "Maximum concurrently active self-serve password reset requests"
msgstr "მაქსიმალური ერთდროულად აქტიური თვითმომსახურების პაროლის გადატვირთვის მოთხოვნა"

# id::coust.description__circ.password_reset_request_throttle
#: 950.data.seed-values.sql:4174
msgid ""
"Prevent the creation of new self-serve password reset requests until the "
"number of active requests drops back below this number."
msgstr "თავიდან აიცილეთ ახალი თვითმომსახურების პაროლის გადატვირთვის მოთხოვნების შექმნა, სანამ აქტიური მოთხოვნების რაოდენობა არ დაიწევს ამ რიცხვის ქვემოთ."

# id::coust.label__circ.password_reset_request_time_to_live
#: 950.data.seed-values.sql:4180
msgid "Self-serve password reset request time-to-live"
msgstr "პაროლის გადატვირთვის მოთხოვნის თვითმომსახურების დრო სიცოცხლისთვის"

# id::coust.description__circ.password_reset_request_time_to_live
#: 950.data.seed-values.sql:4183
msgid ""
"Length of time (in seconds) a self-serve password reset request should "
"remain active."
msgstr "დროის ხანგრძლივობა (წამებში) თვითმომსახურების პაროლის გადატვირთვის მოთხოვნა აქტიური უნდა დარჩეს."

# id::coust.label__circ.patron_edit.clone.copy_address
#: 950.data.seed-values.sql:4189
msgid "Patron Registration: Cloned patrons get address copy"
msgstr "მკითხველის რეგისტრაცია: კლონირებული მკითხველები იღებენ მისამართის ასლს"

# id::coust.description__circ.patron_edit.clone.copy_address
#: 950.data.seed-values.sql:4192
msgid ""
"In the Patron editor, copy addresses from the cloned user instead of linking"
