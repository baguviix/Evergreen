msgstr "დააყენეთ \"circ\" ან \"cat\" საფონდო ცირკულატორის ან კატალოგის ხელსაწყოთა ზოლისთვის, შესაბამისად."

# id::coust.label__ui.general.hotkeyset
#: 950.data.seed-values.sql:5153
msgid "Default Hotkeyset"
msgstr "ნაგულისხმევი Hotkeyset"

# id::coust.description__ui.general.hotkeyset
#: 950.data.seed-values.sql:5156
