msgstr "დამატებითი ინფორმაცია დანართის შესახებ"

#: opac.js:PLACE_HOLD
msgid "Place hold"
msgstr "დაჯავშნა"

#: opac.js:HOLD_STATUS_PLURAL
msgid "hold # ${0} of ${1} total holds and ${2} potential items"
msgstr "ჯავშანი #${0} სულ არსებული ${1} ჯავშნიდან და ${2} პოტენციური ეგზემპლარიდან"

#: opac.js:HOLD_STATUS_SINGULAR
msgid "hold # ${0} of ${1} total holds and ${2} potential item"
msgstr "ჯავშანი #${0} სულ არსებული ${1} ჯავშნიდან და ${2} პოტენციური ეგზემპლარიდან"

#: opac.js:MORE
msgid "More"
msgstr "მეტი"

#: opac.js:MORE_COPIES_FULL_RECORD
msgid "... more copies listed in full record"
msgstr "... დამატებითი ეგზემპლარები სრულ ჩანაწერშია ჩამოთვლილი"

#: opac.js:SOURCE_CANNOT_HAVE_COPIES
msgid "Records from ${0} cannot have copies."
msgstr "${0}-დან მიღებულ ჩანაწერს ეგზემპლარები ვერ ექნება."
