#: opac.js:BARCODE_PROMPT
msgid "Barcode: "
msgstr "შტრიხკოდი: "

#: opac.js:USERNAME_PROMPT
msgid "Username: "
msgstr "მომხმარებლის სახელი: "

#: opac.js:CANCEL_BUTTON_LABEL
msgid "Cancel"
msgstr "გაუქმება"

#: opac.js:SUBMIT_BUTTON_LABEL
msgid "Submit"
msgstr "გაგზავნა"

#: opac.js:OK
msgid "OK"
msgstr "კარგი"

#: opac.js:PWD_RESET_RESPONSE_TITLE
msgid "Password reset response"
msgstr "პაროლის აღდგენის პასუხი"

#: opac.js:PWD_RESET_SUBMIT_SUCCESS
msgid ""
"Your request to begin the password reset process has been processed. If your"
" account has a valid email address, you should soon receive an email "
"containing further instructions for resetting your password."
msgstr "პაროლის აღდგენის დასაწყებად თქვენი მოთხოვნა დამუშავდა. თუ ანგარიშში მოქმედი ელფოსტის მისამართია მითითებული, მალე მიიღებთ წერილს პაროლის აღდგენის ინსტრუქციებით."

#: opac.js:PWD_RESET_SUBMIT_ERROR
msgid ""
"The system could not process your request for a password reset. Please try "
"again, or contact circulation staff for assistance."
msgstr "სისტემამ ვერ დაამუშავა პაროლის აღდგენის მოთხოვნა. გთხოვთ სცადოთ ხელახლა ან დახმარებისთვის მიმართოთ ბიბლიოთეკის თანამშრომლებს."

#: opac.js:PWD_RESET_SUBMIT_STATUS
msgid "Sending request..."
msgstr "მოთხოვნა იგზავნება..."

#: opac.js:PWD_RESET_FORGOT_PROMPT
msgid "Forgot your password?"
msgstr "დაგავიწყდათ პაროლი?"

#: opac.js:PWD_RESET_FORM_TITLE
msgid "Request password reset"
msgstr "პაროლის აღდგენის მოთხოვნა"

#: opac.js:PWD_RESET_SUBMIT_PROMPT
msgid ""
"To begin the password reset process, enter either your barcode or username "
"in the form below and click 'Submit'"
msgstr "პაროლის აღდგენის დასაწყებად ქვემოთ მოცემულ ფორმაში შეიყვანეთ შტრიხკოდი ან მომხმარებლის სახელი და დააჭირეთ „გაგზავნას“."

